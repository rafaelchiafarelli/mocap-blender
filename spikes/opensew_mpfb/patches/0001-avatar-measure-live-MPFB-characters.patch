                  "jaw", "facial", "brow", "nose", "lip", "cheek", "ear",
-                 "leftarm", "rightarm")   # Mixamo upper arms have no "upperarm" in the name
+                 "leftarm", "rightarm",   # Mixamo upper arms have no "upperarm" in the name
