+    "arm_r":   ("r_upperarm", "rightarm", "upper_arm.r", "upperarm01.r", "upperarm02.r"),
+    "farm_l":  ("l_forearm", "leftforearm", "forearm.l", "lowerarm01.l", "lowerarm02.l"),
+    "farm_r":  ("r_forearm", "rightforearm", "forearm.r", "lowerarm01.r", "lowerarm02.r"),
+    "thigh_l": ("l_thigh", "leftupleg", "thigh.l", "upperleg01.l", "upperleg02.l"),
+    "thigh_r": ("r_thigh", "rightupleg", "thigh.r", "upperleg01.r", "upperleg02.r"),
+    "calf_l":  ("l_calf", "leftleg", "shin.l", "lowerleg01.l", "lowerleg02.l"),
+    "calf_r":  ("r_calf", "rightleg", "shin.r", "lowerleg01.r", "lowerleg02.r"),
 }
 
 
@@ -138,6 +174,19 @@ def _bary_grid(k):
 _BARY = {k: _bary_grid(k) for k in range(1, 6)}
 
 
+# MPFB characters carry vertex groups that are not skin weights: a full-weight
+# "body" group, side masks and the helper / joint-cube groups. Left in, "body"
+# wins the dominant-group vote on every vertex and the arms are measured as
+# part of the chest.
+_NON_SKIN_EXACT = {"body", "left", "mid", "right", "helpergeometry", "jointcubes"}
+_NON_SKIN_PREFIX = ("helper-", "joint-", "mhmask-")   # mhmask-*: added with the Rigify rig
+
+
+def _non_skin_group(name):
+    n = name.lower()
+    return n in _NON_SKIN_EXACT or n.startswith(_NON_SKIN_PREFIX)
+
+
 def sample_body(ob, depsgraph, spacing=SPACING):
     """Area-weighted samples over the body surface, each tagged with the dominant
     vertex group of its triangle. Sampling the surface instead of the vertices
@@ -152,14 +201,16 @@ def sample_body(ob, depsgraph, spacing=SPACING):
     except Exception:
         pass
     mw = ev.matrix_world.copy()
-    gname = {g.index: g.name.lower() for g in ob.vertex_groups}
+    gname = {g.index: g.name.lower() for g in ob.vertex_groups
+             if not _non_skin_group(g.name)}
 
     co = [mw @ v.co for v in me.vertices]
     dom_v = []
     for v in me.vertices:
-        if v.groups:
-            top = max(v.groups, key=lambda g: g.weight)
-            dom_v.append(gname.get(top.group, ""))
+        skin = [g for g in v.groups if g.group in gname and g.weight > 0.0]
+        if skin:
+            top = max(skin, key=lambda g: g.weight)
+            dom_v.append(gname[top.group])
         else:
             dom_v.append("")
 
@@ -505,7 +556,7 @@ def measure(context, ob=None, force=False):
     lm = {}
     if arm is not None:
         mw = arm.matrix_world
-        for name, cands in BONE_TABLE.items():
+        for name, cands in bone_table(arm).items():
             b = _find_bone(arm, cands)
             if b is not None:
                 lm[name] = (mw @ b.head).z
@@ -667,12 +718,14 @@ def torso_bvh(context, ob=None):
     except Exception:
         return None
     mw = ev.matrix_world.copy()
-    gname = {g.index: g.name.lower() for g in ob.vertex_groups}
+    gname = {g.index: g.name.lower() for g in ob.vertex_groups
+             if not _non_skin_group(g.name)}
     excl = []
     for v in me.vertices:
         d = ""
-        if v.groups:
-            d = gname.get(max(v.groups, key=lambda g: g.weight).group, "")
+        skin = [g for g in v.groups if g.group in gname and g.weight > 0.0]
+        if skin:
+            d = gname[max(skin, key=lambda g: g.weight).group]
         excl.append(any(k in d for k in EXCLUDE_TORSO))
     verts = [mw @ v.co for v in me.vertices]
     tris = [tuple(t.vertices) for t in me.loop_triangles
