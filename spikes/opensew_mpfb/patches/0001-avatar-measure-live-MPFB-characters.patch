-                ["cc_base_l_forearm", "mixamorig:leftforearm", "forearm.l"]),
-    "arm_r":   (["cc_base_r_upperarm", "mixamorig:rightarm", "upper_arm.r"],
-                ["cc_base_r_forearm", "mixamorig:rightforearm", "forearm.r"]),
-    "farm_l":  (["cc_base_l_forearm", "mixamorig:leftforearm", "forearm.l"],
-                ["cc_base_l_hand", "mixamorig:lefthand", "hand.l"]),
-    "farm_r":  (["cc_base_r_forearm", "mixamorig:rightforearm", "forearm.r"],
-                ["cc_base_r_hand", "mixamorig:righthand", "hand.r"]),
-    "thigh_l": (["cc_base_l_thigh", "mixamorig:leftupleg", "thigh.l"],
-                ["cc_base_l_calf", "mixamorig:leftleg", "shin.l"]),
-    "thigh_r": (["cc_base_r_thigh", "mixamorig:rightupleg", "thigh.r"],
-                ["cc_base_r_calf", "mixamorig:rightleg", "shin.r"]),
-    "calf_l":  (["cc_base_l_calf", "mixamorig:leftleg", "shin.l"],
+    # last candidate in each list: MPFB's default rig (upperarm01/lowerarm01/
+    # wrist, upperleg01/lowerleg01/foot)
+    "arm_l":   (["cc_base_l_upperarm", "mixamorig:leftarm", "upper_arm.l", "upperarm01.l"],
+                ["cc_base_l_forearm", "mixamorig:leftforearm", "forearm.l", "lowerarm01.l"]),
+    "arm_r":   (["cc_base_r_upperarm", "mixamorig:rightarm", "upper_arm.r", "upperarm01.r"],
+                ["cc_base_r_forearm", "mixamorig:rightforearm", "forearm.r", "lowerarm01.r"]),
+    "farm_l":  (["cc_base_l_forearm", "mixamorig:leftforearm", "forearm.l", "lowerarm01.l"],
+                ["cc_base_l_hand", "mixamorig:lefthand", "hand.l", "wrist.l"]),
+    "farm_r":  (["cc_base_r_forearm", "mixamorig:rightforearm", "forearm.r", "lowerarm01.r"],
+                ["cc_base_r_hand", "mixamorig:righthand", "hand.r", "wrist.r"]),
+    "thigh_l": (["cc_base_l_thigh", "mixamorig:leftupleg", "thigh.l", "upperleg01.l"],
+                ["cc_base_l_calf", "mixamorig:leftleg", "shin.l", "lowerleg01.l"]),
+    "thigh_r": (["cc_base_r_thigh", "mixamorig:rightupleg", "thigh.r", "upperleg01.r"],
+                ["cc_base_r_calf", "mixamorig:rightleg", "shin.r", "lowerleg01.r"]),
+    "calf_l":  (["cc_base_l_calf", "mixamorig:leftleg", "shin.l", "lowerleg01.l"],
                 ["cc_base_l_foot", "mixamorig:leftfoot", "foot.l"]),
-    "calf_r":  (["cc_base_r_calf", "mixamorig:rightleg", "shin.r"],
+    "calf_r":  (["cc_base_r_calf", "mixamorig:rightleg", "shin.r", "lowerleg01.r"],
                 ["cc_base_r_foot", "mixamorig:rightfoot", "foot.r"]),
 }
 # Vertex groups whose verts must not contribute to the torso cross-sections.
@@ -52,17 +84,21 @@ LIMB_CHAINS = {
