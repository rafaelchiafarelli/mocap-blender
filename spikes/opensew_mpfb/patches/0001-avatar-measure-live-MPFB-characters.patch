From d5c957413207b1ee5e0fe0c91cfa9e2774bef9b8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 19:41:43 -0300
Subject: [PATCH] avatar: measure live MPFB characters

Teach the avatar measurement MPFB's rigs and vertex groups:

- ignore MPFB's non-skin vertex groups (body, side masks, helper-*,
  joint-*, mhmask-*) when picking a sample's dominant group; the full-weight
  'body' group otherwise wins everywhere and the arms are measured as chest
- RIG_DIALECTS: torso landmark bones for MPFB's default rig (spine numbered
  top-down) and MPFB's Rigify metarig (neck on spine.005)
- limb chains and limb groups for MPFB's default rig (upperarm01, lowerarm01,
  wrist, upperleg01, lowerleg01)
- keep upper_arm, lowerarm, finger, metacarpal and the Rigify deltoid helper
  out of the torso cross-sections (MPFB's A-pose hangs the fingers at hip height)
---
 clothing_design/avatar.py | 115 ++++++++++++++++++++++++++++----------
 1 file changed, 84 insertions(+), 31 deletions(-)

diff --git a/clothing_design/avatar.py b/clothing_design/avatar.py
index 7ec633e..6db9b01 100644
--- a/clothing_design/avatar.py
+++ b/clothing_design/avatar.py
@@ -25,24 +25,56 @@ BONE_TABLE = {
     "waist":  ["cc_base_waist", "mixamorig:spine", "spine.001", "waist", "spine01"],
     "hip":    ["cc_base_pelvis", "mixamorig:hips", "pelvis", "hips", "spine"],
 }
+# MPFB rigs whose spine bones the generic table above would misread: MPFB's
+# default rig numbers its spine top-down (spine01 is the upper chest, spine05
+# the pelvis), and MPFB's Rigify metarig puts the neck on spine.005, not on
+# spine.004 as a generated Rigify rig does. These only seed the landmarks -
+# waist, chest and hip are refined from the body's own cross-sections below.
+RIG_DIALECTS = {
+    "mpfb_default": {"neck": ["neck01"], "chest": ["spine01"],
+                     "waist": ["spine03"], "hip": ["spine05"]},
+    "mpfb_rigify":  {"neck": ["spine.005"], "chest": ["spine.004"],
+                     "waist": ["spine.002"], "hip": ["spine"]},
+}
+
+
+def rig_dialect(arm):
+    """Name of the RIG_DIALECTS entry for this armature, or None."""
+    if arm is None:
+        return None
+    names = {b.name.lower() for b in arm.data.bones}
+    if "spine05" in names and "neck01" in names:
+        return "mpfb_default"
+    if "spine.006" in names and "upper_arm.l" in names:
+        return "mpfb_rigify"
+    return None
+
+
+def bone_table(arm):
+    return RIG_DIALECTS.get(rig_dialect(arm), BONE_TABLE)
+
+
+
