  {"control": "B", "state": "object_mode", "equals": "OBJECT", "led": "blink", "on_ms": 200, "off_ms": 200},
  {"control": "C", "state": "object_mode", "equals": "VERTEX_PAINT", "led": "blink", "on_ms": 200, "off_ms": 200},
