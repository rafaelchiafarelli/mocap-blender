<mxfile host="drawio" type="device"><diagram id="02-classes" name="02-classes"><mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Profile&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;device: str&lt;br&gt;port_name_contains: str&lt;br&gt;controls: dict&lt;br&gt;layers: dict&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;load(path) : Profile&lt;br&gt;decode(b0, b1, b2) : [(id, event)]&lt;br&gt;led(id) : (b0, b1) | None&lt;br&gt;all_leds() / meters()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="180" as="geometry"/></mxCell><mxCell id="c4" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Mapping&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;device: str&lt;br&gt;bindings: list&lt;br&gt;indicators: list&lt;br&gt;scales: dict&lt;br&gt;toggles: dict&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;load(path) : Mapping&lt;br&gt;validate(profile, states, actions)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="300" height="165" as="geometry"/></mxCell><mxCell id="c5" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Engine&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;layers: dict&lt;br&gt;scales: dict&lt;br&gt;toggles: dict&lt;br&gt;armed: set (centre tap)&lt;br&gt;active: bool (owner)&lt;br&gt;last_error: str&lt;br&gt;_flash: dict&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;handle(b0, b1, b2)&lt;br&gt;update()&lt;br&gt;state(name)&lt;br&gt;start_intro(leds=None)&lt;br&gt;set_active(active)&lt;br&gt;shutdown()&lt;br&gt;_fire(cid, event, binding, value)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="320" height="270" as="geometry"/></mxCell><mxCell id="c6" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;b&gt;LedDriver&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;_want: dict&lt;br&gt;_sent: dict&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;set(addr, look, now)&lt;br&gt;tick(now)&lt;br&gt;forget(addr)&lt;br&gt;resend()&lt;br&gt;all_off()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="40" width="260" height="165" as="geometry"/></mxCell><mxCell id="c7" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;blender_glue&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;Session&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;queue: SimpleQueue&lt;br&gt;midi_in / midi_out&lt;br&gt;engine: Engine&lt;br&gt;owner: callable&lt;br&gt;debug: file | None&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;tick()  (every 20 ms)&lt;br&gt;set_debug(on)&lt;br&gt;close()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="320" height="195" as="geometry"/></mxCell><mxCell id="c8" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;winmm&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;MidiIn&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;handle&lt;br&gt;callback&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;close()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="200" height="120" as="geometry"/></mxCell><mxCell id="c9" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;winmm&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;MidiOut&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;handle&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;send(b0, b1, b2)&lt;br&gt;close()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1050" y="560" width="200" height="120" as="geometry"/></mxCell><mxCell id="c10" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;bpy.types.Operator&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;CONTROLSURFACE_OT_grab&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;mode: MOVE|SCALE|ROTATE&lt;br&gt;axis: FREE|X|Y|Z|NORMAL&lt;br&gt;start, vstart, pivot&lt;br&gt;push_move / push_scale / push_angle&lt;br&gt;snap (90° angle)&lt;br&gt;targets: Targets&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;invoke() / modal()&lt;br&gt;_apply()&lt;br&gt;_take_pushes() / _take_tips()&lt;br&gt;_snap_hit() / _snap_source()&lt;br&gt;_end(confirm)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="330" height="240" as="geometry"/></mxCell><mxCell id="c11" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;snap&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;Targets&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;verts: ndarray (world)&lt;br&gt;edges: ndarray&lt;br&gt;ray_exclude: set&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;find(ctx, region, rv3d, mouse, elems)&lt;br&gt;_project(region, rv3d)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="860" width="300" height="150" as="geometry"/></mxCell><mxCell id="c12" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;bpy.types.Panel&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;CONTROLSURFACE_PT_menu_window&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;bl_space_type = NLA_EDITOR&lt;br&gt;bl_category = 4-Mix&lt;br&gt;bl_options = HIDE_HEADER&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;poll(): screen is the 4-Mix window&lt;br&gt;draw(): Add level, Properties level&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="760" width="340" height="150" as="geometry"/></mxCell><mxCell id="c13" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;bpy.types.Operator&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;menu operators&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;menu_pick(menu, index)  → IN&lt;br&gt;menu_back(menu)  → OUT&lt;br&gt;menu_close()  → SYNC&lt;br&gt;cursor_to_mouse&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0;margin-left:4px;"&gt;&amp;nbsp;&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1200" y="760" width="300" height="135" as="geometry"/></mxCell><mxCell id="c14" value="uses" style="endArrow=open;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="applies" style="endArrow=open;dashed=1;html=1;rounded=0;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="owns 1" style="endArrow=none;startArrow=diamondThin;startFill=1;html=1;" edge="1" parent="1" source="c5" t