<mxfile host="drawio" type="device"><diagram id="03-message-flow" name="03-message-flow"><mxGraphModel dx="1500" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="MIDI message from the 4-Mix&lt;br&gt;(b0, b1, b2)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="240" height="60" as="geometry"/></mxCell><mxCell id="c4" value="WinMM callback thread:&lt;br&gt;queue.put(msg)  (no bpy here)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="240" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Blender timer, every 20 ms:&lt;br&gt;Session.tick()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="240" height="60" as="geometry"/></mxCell><mxCell id="c6" value="engine.set_active(owner_is_me())&lt;br&gt;focused Blender owns the controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="240" height="60" as="geometry"/></mxCell><mxCell id="c7" value="up to MAX_MESSAGES_PER_TICK:&lt;br&gt;engine.handle(msg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="240" height="60" as="geometry"/></mxCell><mxCell id="c8" value="channel changed&lt;br&gt;a deck layer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="580" y="470" width="200" height="90" as="geometry"/></mxCell><mxCell id="c9" value="leds.resend()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=